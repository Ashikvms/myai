{
  "expo": {
    "name": "Life Admin AI",
    "slug": "life-admin-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lifeadminai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#6366F1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifeadminai.app"
    },
    "android": {
      "package": "com.lifeadminai.app",
      "adaptiveIcon": {
        "backgroundColor": "#6366F1"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366F1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────

enum Plan {
  FREE
  PREMIUM
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum BillFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum BillStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum DocumentCategory {
  INSURANCE
  LEASE
  CAR
  TAX
  MEDICAL
  WARRANTY
  IDENTITY
  OTHER
}

enum ReminderLinkedType {
  TASK
  BILL
  SUBSCRIPTION
  APPOINTMENT
  DOCUMENT
  NONE
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum PlaidItemStatus {
  ACTIVE
  LOGIN_REQUIRED
  ERROR
  DISCONNECTED
}

enum BankAccountType {
  DEPOSITORY
  CREDIT
  LOAN
  INVESTMENT
  OTHER
}

enum BankAccountSubtype {
  CHECKING
  SAVINGS
  HSA
  CD
  MONEY_MARKET
  PAYPAL
  PREPAID
  CREDIT_CARD
  AUTO
  MORTGAGE
  STUDENT
  PERSONAL
  OTHER
}

enum PlaidWebhookStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

enum BankDataAccessAction {
  READ
  WRITE
  SYNC
  EXPORT
  DELETE
  LINK
  UNLINK
}

// ── Models ─────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  name              String
  avatarUrl         String?
  googleId          String?   @unique
  plan              Plan      @default(FREE)
  onboardingComplete Boolean  @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tasks             Task[]
  bills             Bill[]
  subscriptions     Subscription[]
  documents         Document[]
  appointments      Appointment[]
  reminders         Reminder[]
  aiConversations   AiConversation[]
  notificationPref  NotificationPreference?
  refreshTokens     RefreshToken[]

  plaidItems         PlaidItem[]
  bankAccounts       BankAccount[]
  transactions       Transaction[]
  bankDataAccessLogs BankDataAccessLog[]

  @@map("users")
}

model RefreshToken {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String
  expiresAt    DateTime
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Task {
  id             String      @id @default(cuid())
  userId         String
  title          String      @db.VarChar(200)
  notes          String?     @db.Text
  dueDate        DateTime?
  category       String?     @db.VarChar(50)
  priority       Priority    @default(MEDIUM)
  status         TaskStatus  @default(PENDING)
  isRecurring    Boolean     @default(false)
  recurrenceRule String?
  completedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dueDate])
  @@index([userId, deletedAt])
  @@map("tasks")
}

model Bill {
  id          String        @id @default(cuid())
  userId      String
  name        String        @db.VarChar(200)
  category    String        @db.VarChar(50)
  amount      Decimal       @db.Decimal(10, 2)
  frequency   BillFrequency
  nextDueDate DateTime
  isAutopay   Boolean       @default(false)
  notes       String?       @db.Text
  status      BillStatus    @default(ACTIVE)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  detectedFromTxnId String?  @db.VarChar(80)
  autoDetected      Boolean  @default(false)

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  detectedTransactions Transaction[]

  @@index([userId])
  @@index([nextDueDate])
  @@index([userId, deletedAt])
  @@map("bills")
}

model Subscription {
  id               String        @id @default(cuid())
  userId           String
  name             String        @db.VarChar(200)
  category         String        @db.VarChar(50)
  amount           Decimal       @db.Decimal(10, 2)
  frequency        BillFrequency
  nextRenewalDate  DateTime
  isAutopay        Boolean       @default(false)
  notes            String?       @db.Text
  status           BillStatus    @default(ACTIVE)
  cancellationDate DateTime?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  detectedFromTxnId String?  @db.VarChar(80)
  autoDetected      Boolean  @default(false)

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  detectedTransactions Transaction[]

  @@index([userId])
  @@index([nextRenewalDate])
  @@index([userId, deletedAt])
  @@map("subscriptions")
}

model Document {
  id             String           @id @default(cuid())
  userId         String
  title          String           @db.VarChar(200)
  category       DocumentCategory
  issueDate      DateTime?
  expirationDate DateTime?
  notes          String?          @db.Text
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  mimeType       String?
  summary        String?          @db.Text
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expirationDate])
  @@index([userId, deletedAt])
  @@map("documents")
}

model Appointment {
  id              String   @id @default(cuid())
  userId          String
  title           String   @db.VarChar(200)
  dateTime        DateTime
  endTime         DateTime?
  location        String?  @db.VarChar(500)
  notes           String?  @db.Text
  category        String?  @db.VarChar(50)
  reminderMinutes Int      @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dateTime])
  @@map("appointments")
}

model Reminder {
  id             String            @id @default(cuid())
  userId         String
  title          String            @db.VarChar(200)
  dateTime       DateTime
  isRecurring    Boolean           @default(false)
  recurrenceRule String?
  linkedType     ReminderLinkedType @default(NONE)
  linkedId       String?
  status         ReminderStatus    @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dateTime])
  @@index([status])
  @@map("reminders")
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String         @db.Text
  metadata       Json?
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailNotifications    Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  billReminders         Boolean  @default(true)
  appointmentReminders  Boolean  @default(true)
  documentExpiry        Boolean  @default(true)
  taskReminders         Boolean  @default(true)
  reminderLeadDays      Int      @default(3)
  pushToken             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ── Plaid integration models ──────────────

model PlaidItem {
  id                    String           @id @default(cuid())
  userId                String
  plaidItemId           String           @unique
  accessTokenCiphertext String           @db.Text
  accessTokenKeyVersion Int              @default(1)
  institutionId         String
  institutionName       String           @db.VarChar(200)
  institutionLogo       String?
  status                PlaidItemStatus  @default(ACTIVE)
  errorCode             String?
  errorMessage          String?          @db.Text
  cursor                String?          @db.Text
  consentExpiresAt      DateTime?
  lastSyncAt            DateTime?
  lastWebhookAt         DateTime?
  deletedAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts      BankAccount[]
  webhookEvents PlaidWebhookEvent[]

  @@index([userId])
  @@index([userId, status])
  @@index([plaidItemId])
  @@map("plaid_items")
}

model BankAccount {
  id                String              @id @default(cuid())
  userId            String
  plaidItemId       String
  plaidAccountId    String              @unique
  name              String              @db.VarChar(200)
  officialName      String?             @db.VarChar(200)
  mask              String?             @db.VarChar(8)
  type              BankAccountType
  subtype           BankAccountSubtype?
  isoCurrencyCode   String              @default("USD") @db.VarChar(3)
  currentBalance    Decimal?            @db.Decimal(14, 2)
  availableBalance  Decimal?            @db.Decimal(14, 2)
  creditLimit       Decimal?            @db.Decimal(14, 2)
  isHidden          Boolean             @default(false)
  lastBalanceUpdate DateTime?
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem    PlaidItem     @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([plaidItemId])
  @@map("bank_accounts")
}

model Transaction {
  id                 String    @id @default(cuid())
  userId             String
  bankAccountId      String
  plaidTransactionId String    @unique
  plaidPendingId     String?
  amount             Decimal   @db.Decimal(14, 2)
  isoCurrencyCode    String    @default("USD") @db.VarChar(3)
  date               DateTime  @db.Date
  authorizedDate     DateTime? @db.Date
  name               String    @db.VarChar(500)
  merchantName       String?   @db.VarChar(200)
  merchantLogoUrl    String?
  category           String?   @db.VarChar(80)
  categoryDetailed   String?   @db.VarChar(120)
  paymentChannel     String?   @db.VarChar(40)
  pending            Boolean   @default(false)
  isoLocationCity    String?   @db.VarChar(100)
  isoLocationRegion  String?   @db.VarChar(100)
  isoLocationCountry String?   @db.VarChar(2)
  billId             String?
  subscriptionId     String?
  matchConfidence    Decimal?  @db.Decimal(4, 3)
  userVerifiedMatch  Boolean   @default(false)
  userNote           String?   @db.Text
  receiptUrl         String?   @db.VarChar(500)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bill         Bill?         @relation(fields: [billId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, date(sort: Desc)])
  @@index([userId, bankAccountId, date(sort: Desc)])
  @@index([userId, category])
  @@index([userId, merchantName])
  @@index([billId])
  @@index([subscriptionId])
  @@map("transactions")
}

model PlaidWebhookEvent {
  id              String             @id @default(cuid())
  plaidItemId     String?
  webhookType     String             @db.VarChar(60)
  webhookCode     String             @db.VarChar(60)
  externalEventId String?            @unique
  rawPayload      Json
  status          PlaidWebhookStatus @default(PENDING)
  processingError String?            @db.Text
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?

  plaidItem PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)

  @@index([plaidItemId])
  @@index([status, receivedAt])
  @@index([webhookType, webhookCode])
  @@map("plaid_webhook_events")
}

model BankDataAccessLog {
  id          String               @id @default(cuid())
  userId      String?
  actorUserId String
  action      BankDataAccessAction
  resource    String               @db.VarChar(80)
  resourceId  String?              @db.VarChar(80)
  ipAddress   String?              @db.VarChar(64)
  userAgent   String?              @db.VarChar(400)
  context     Json?
  createdAt   DateTime             @default(now())

  // SetNull on user delete preserves audit history for compliance even after
  // the user is purged. Postgres allows multiple NULLs in a non-unique index.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("bank_data_access_logs")
}

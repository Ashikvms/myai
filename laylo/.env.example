# ── App ─────────────────────────────────────
NODE_ENV=production
APP_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# ── Database (Railway — auto-provided) ───────
DATABASE_URL=postgresql://user:pass@host:5432/railway

# ── Cache (Upstash) ──────────────────────────
REDIS_URL=redis://...

# ── Auth ─────────────────────────────────────
JWT_PRIVATE_KEY=        # openssl genrsa 2048 | base64
JWT_PUBLIC_KEY=         # openssl rsa -pubout | base64
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback

# ── Storage (Cloudflare R2) ───────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lifeadmin-documents
R2_PUBLIC_URL=

# ── AI (Anthropic) ────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ── Email (Resend) ────────────────────────────
RESEND_API_KEY=

# ── Mobile (Expo) ────────────────────────────
EXPO_ACCESS_TOKEN=

# ── Monitoring (Sentry) ───────────────────────
SENTRY_DSN=

# ── Security ─────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── Plaid + Encryption ──────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,auth
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# ── Google integrations (Calendar + Gmail) ──
# Same Google Cloud OAuth credentials as login above; just add scopes +
# the separate "link" redirect used by /api/google/link for already-
# logged-in users. Both redirect URIs must be registered in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_LINK_REDIRECT_URI=http://localhost:3001/api/google/link/callback
# Where the browser is sent after a successful link. Defaults to APP_URL.
GOOGLE_LINK_SUCCESS_REDIRECT=
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
GOOGLE_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.modify
